{% extends 'layout.twig' %}
{% block content %}
<div class="mx-auto mt-16 w-full max-w-sm">
<div class="card p-6">
<h2 class="font-display mb-1 text-2xl">Kratos Invoice</h2>
<p class="mb-5 text-sm text-slate-500">Sign in to continue</p>
<form method="post" action="/login" class="flex flex-col gap-3">
<label class="text-sm font-medium">Email<input class="field mt-1" name="email" type="email" required autofocus></label>
<label class="text-sm font-medium">Password<input class="field mt-1" name="password" type="password" required></label>
<button class="btn btn-primary justify-center">Login</button>
</form>
</div></div>
{% endblock %}
