{% extends 'layout.twig' %}
{% block content %}
<h2 class="font-display mb-1 text-2xl">Summary</h2>
<p class="mb-3 text-xs text-slate-500">Quotation metrics use quotation doc dates · Invoice value/balance use invoice doc dates · Payments use payment dates · Balances show current state of invoices in range. Cancelled docs and voided payments excluded.</p>
<form class="mb-4 flex flex-wrap items-end gap-2" method="get">
<label class="text-sm font-medium">From<input class="field mt-1" type="date" name="from" value="{{ from }}"></label>
<label class="text-sm font-medium">To<input class="field mt-1" type="date" name="to" value="{{ to }}"></label>
<label class="text-sm font-medium">Customer<select class="field mt-1" name="customer_id"><option value="">All</option>{% for c in customers %}<option value="{{ c.id }}" {{ q.customer_id==c.id?'selected' }}>{{ c.name }}</option>{% endfor %}</select></label>
<label class="text-sm font-medium">Search<input class="field mt-1" name="s" value="{{ q.s ?? '' }}"></label>
<div class="flex gap-2"><button class="btn btn-default">Apply</button> <button class="btn btn-default" name="export" value="csv">CSV</button></div>
</form>
<div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
<div class="card p-4"><div class="text-sm text-slate-500">Awaiting decision</div><div class="font-display text-xl">{{ await|idr }}</div></div>
<div class="card p-4"><div class="text-sm text-slate-500">Accepted quotations</div><div class="font-display text-xl">{{ acc|idr }}</div></div>
<div class="card p-4"><div class="text-sm text-slate-500">Issued invoice value</div><div class="font-display text-xl">{{ inv|idr }}</div></div>
<div class="card p-4"><div class="text-sm text-slate-500">Payments received</div><div class="font-display text-xl text-emerald-600">{{ paid|idr }}</div></div>
<div class="card p-4"><div class="text-sm text-slate-500">Outstanding</div><div class="font-display text-xl">{{ out|idr }}</div></div>
<div class="card p-4"><div class="text-sm text-slate-500">Overdue</div><div class="font-display text-xl text-red-600">{{ over|idr }}</div></div>
<div class="card p-4"><div class="text-sm text-slate-500">DP requested</div><div class="font-display text-xl">{{ dpReq|idr }}</div></div>
<div class="card p-4"><div class="text-sm text-slate-500">DP received</div><div class="font-display text-xl">{{ dpGot|idr }}</div></div>
<div class="card p-4"><div class="text-sm text-slate-500">DP still due</div><div class="font-display text-xl">{{ dpDue|idr }}</div></div>
</div>
<div class="mt-4 overflow-x-auto"><table id="sgrid" class="tbl w-full text-sm" data-url="/api/grid/summary?from={{ from|url_encode }}&to={{ to|url_encode }}&customer_id={{ (q.customer_id ?? '')|url_encode }}&s={{ (q.s ?? '')|url_encode }}"></table></div>
<table class="tbl mt-4 w-full text-sm" id="sgrid-fallback"><thead><tr><th class="px-3 py-2">Number</th><th class="px-3 py-2">Customer</th><th class="px-3 py-2">Date</th><th class="px-3 py-2 text-right">Total</th><th class="px-3 py-2 text-right">DP req</th><th class="px-3 py-2 text-right">DP paid</th><th class="px-3 py-2 text-right">Paid</th><th class="px-3 py-2 text-right">Balance</th></tr></thead><tbody>
{% for r in rows %}<tr class="border-t border-slate-100"><td class="px-3 py-2"><a class="text-brand-600 hover:underline" href="/invoices/{{ r.id }}">{{ r.number }}</a></td><td class="px-3 py-2">{{ r.customer_name }}</td><td class="px-3 py-2">{{ r.doc_date|d }}</td><td class="px-3 py-2 text-right">{{ r.total|idr }}</td><td class="px-3 py-2 text-right">{{ r.dp_amount|idr }}</td><td class="px-3 py-2 text-right">{{ r.dp_paid|idr }}</td><td class="px-3 py-2 text-right">{{ r.paid|idr }}</td><td class="px-3 py-2 text-right">{{ (r.total - r.paid)|idr }}</td></tr>{% else %}<tr><td colspan="8" class="px-3 py-4 text-center text-slate-400">No data.</td></tr>{% endfor %}
</tbody></table>
{% endblock %}
{% block scripts %}
<link rel="stylesheet" href="{{ asset('vendor/datatables/dataTables.dataTables.min.css') }}">
<link rel="stylesheet" href="{{ asset('css/datatables-uikit.css') }}">
<script src="{{ asset('vendor/datatables/dataTables.min.js') }}"></script>
<script src="{{ asset('js/grids.js') }}"></script>
<script>
mountDataTable('sgrid', [
  { data: 'number', title: 'Number', render: function(d, t, row) {
    if (t !== 'display' && t !== 'filter') return d;
    return '<a class="text-brand-600 hover:underline" href="/invoices/' + row.id + '">' + escapeHtml(d) + '</a>';
  }},
  { data: 'customer', title: 'Customer' },
  { data: 'date_iso', title: 'Date', render: dateCell },
  { data: 'total_num', title: 'Total', className: 'dt-right', render: moneyCell },
  { data: 'dp_req_num', title: 'DP req', className: 'dt-right', render: moneyCell },
  { data: 'dp_paid_num', title: 'DP paid', className: 'dt-right', render: moneyCell },
  { data: 'paid_num', title: 'Paid', className: 'dt-right', render: moneyCell },
  { data: 'bal_num', title: 'Balance', className: 'dt-right', render: moneyCell }
]);
</script>
{% endblock %}
