{% extends 'layout.twig' %}
{% block content %}
<h2 class="font-display mb-1 text-2xl">Invoice {{ d.number ? '#' ~ d.number : '(draft)' }} <span class="inline-block rounded px-2 py-0.5 text-xs font-medium text-white badge-{{ d.status }}">{{ d.status }}</span>
{% set payst = d.balance == 0 and d.total > 0 ? 'paid' : (d.paid > 0 ? 'partial' : 'unpaid') %}
<span class="inline-block rounded px-2 py-0.5 text-xs font-medium text-white badge-{{ payst }}">{{ payst }}</span>
{% if d.status=='issued' and d.due_date and d.due_date < 'now'|date('Y-m-d') and d.balance > 0 %}<span class="inline-block rounded bg-red-600 px-2 py-0.5 text-xs font-medium text-white">overdue</span>{% endif %}</h2>
<p class="mb-4 text-sm text-slate-600">Customer: {{ d.customer_snapshot ? (d.customer_snapshot|json_decode).name : '' }} · Date: {{ d.doc_date|d }} · Due: {{ d.due_date|d }}<br>Ref: {{ d.reference ?? '-' }}{% if d.source_quotation_id %} · From quotation <a class="text-brand-600 hover:underline" href="/quotations/{{ d.source_quotation_id }}">#{{ d.source_quotation_id }}</a>{% endif %}</p>
{% for sec in d.sections %}<div class="card mb-3 p-4"><h4 class="font-display text-lg">{{ sec.title }}</h4>
<table class="tbl mt-2 w-full text-sm"><thead><tr><th class="px-2 py-1.5">Description</th><th class="px-2 py-1.5">Qty</th><th class="px-2 py-1.5 text-right">Price</th><th class="px-2 py-1.5 text-right">Total</th></tr></thead><tbody>
{% for l in sec.lines %}<tr class="border-t border-slate-100"><td class="px-2 py-1.5">{{ l.description }}{% if l.waived %} <span class="inline-block rounded bg-slate-500 px-2 py-0.5 text-xs font-medium text-white">{{ l.price_mode }}</span>{% elseif l.mult_enabled %} <span class="block text-xs text-slate-500">{{ l.quantity }} {{ l.unit_label }} × {{ l.mult_value }} {{ l.mult_label }} × {{ l.unit_price|idr }}</span>{% endif %}</td><td class="px-2 py-1.5">{{ l.quantity }} {{ l.unit_label }}</td><td class="px-2 py-1.5 text-right">{{ l.waived ? l.price_mode|capitalize : l.unit_price|idr }}</td><td class="px-2 py-1.5 text-right">{{ l.line_amount|idr }}</td></tr>{% endfor %}
</tbody></table></div>{% endfor %}
<div class="card mb-3 p-4"><table class="w-full text-sm"><tr><td class="py-1">Subtotal</td><td class="py-1 text-right">{{ d.subtotal|idr }}</td></tr><tr><td class="py-1">Discount</td><td class="py-1 text-right">− {{ d.discount_amount|idr }}</td></tr><tr><td class="py-1">Tax</td><td class="py-1 text-right">{{ d.tax_total|idr }}</td></tr><tr class="font-semibold"><td class="py-1">Total</td><td class="py-1 text-right">{{ d.total|idr }}</td></tr>
<tr><td class="py-1">Requested DP</td><td class="py-1 text-right">{{ d.dp_amount|idr }}</td></tr><tr><td class="py-1">DP received</td><td class="py-1 text-right">{{ d.dp_paid|idr }}</td></tr><tr><td class="py-1">Total paid</td><td class="py-1 text-right">{{ d.paid|idr }}</td></tr><tr class="font-semibold"><td class="py-1">Outstanding balance</td><td class="py-1 text-right">{{ d.balance|idr }}</td></tr></table></div>
<div class="card mb-3 p-4"><h4 class="font-display mb-2 text-lg">Payments</h4>
<table class="tbl w-full text-sm"><thead><tr><th class="px-2 py-1.5">Date</th><th class="px-2 py-1.5 text-right">Amount</th><th class="px-2 py-1.5">Purpose</th><th class="px-2 py-1.5">Method</th><th class="px-2 py-1.5">Ref</th><th class="px-2 py-1.5"></th></tr></thead><tbody>
{% for p in d.payments %}<tr class="border-t border-slate-100"><td class="px-2 py-1.5">{{ p.pay_date|d }}</td><td class="px-2 py-1.5 text-right">{{ p.amount|idr }}</td><td class="px-2 py-1.5">{{ p.purpose }}</td><td class="px-2 py-1.5">{{ p.method }}</td><td class="px-2 py-1.5">{{ p.reference }}</td><td class="px-2 py-1.5">{% if not p.voided_at and d.status=='issued' %}<form method="post" action="/payments/{{ p.id }}/void">{{ csrf() }}<input type="hidden" name="reason" value="void from UI"><button class="btn btn-danger btn-sm" onclick="return confirm('Void payment?')">Void</button></form>{% else %}{{ p.voided_at ? 'voided' }}{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="px-2 py-3 text-center text-slate-400">No payments.</td></tr>{% endfor %}
</tbody></table></div>
{% if d.status=='issued' and d.balance > 0 %}
<div class="card mb-3 p-4"><h4 class="font-display mb-2 text-lg">Record payment</h4>
<form method="post" action="/invoices/{{ d.id }}/payments" class="flex flex-wrap gap-2">{{ csrf() }}
<input class="field max-w-[10rem]" name="amount" placeholder="Amount IDR" required>
<input class="field max-w-[10rem]" type="date" name="pay_date" value="{{ 'now'|date('Y-m-d') }}">
<select class="field max-w-[10rem]" name="purpose"><option value="balance">balance</option><option value="dp">down payment</option><option value="other">other</option></select>
<input class="field max-w-[10rem]" name="method" value="Transfer">
<input class="field max-w-[10rem]" name="reference" placeholder="Reference">
<button class="btn btn-primary">Add payment</button></form></div>{% endif %}
<div class="mb-4 flex flex-wrap gap-2">
{% if d.status=='draft' %}<a class="btn btn-default" href="/invoices/{{ d.id }}/edit">Edit</a>
<form style="display:inline" method="post" action="/invoices/{{ d.id }}/issue">{{ csrf() }}<button class="btn btn-primary" onclick="return confirm('Issue invoice?')">Issue</button></form>{% endif %}
{% if d.status=='issued' %}<form style="display:inline" method="post" action="/invoices/{{ d.id }}/cancel">{{ csrf() }}<input type="hidden" name="reason" value="cancelled from UI"><button class="btn btn-danger" onclick="return confirm('Cancel invoice?')">Cancel</button></form>{% endif %}
<a class="btn btn-default" href="/invoices/{{ d.id }}/pdf" target="_blank">Preview PDF</a>
<a class="btn btn-default" href="/invoices/{{ d.id }}/pdf?dl=1">Download</a>
</div>
<h4 class="font-display mb-1 text-lg">Audit</h4><ul class="list-disc pl-5 text-sm text-slate-600">{% for l in logs %}<li>{{ l.created_at }} — {{ l.action }} {{ l.detail }}</li>{% endfor %}</ul>
{% endblock %}
