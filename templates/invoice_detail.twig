{% extends 'layout.twig' %}
{% block content %}
{% set payst = d.balance == 0 and d.total > 0 ? 'paid' : (d.paid > 0 ? 'partial' : 'unpaid') %}
<div class="inv-hero">
  <div class="inv-hero-top">
    <div>
      <div class="inv-eyebrow">Invoice</div>
      <div class="inv-title">{{ d.number ? '#' ~ d.number : '(draft)' }}</div>
      <div class="inv-badges">
        <span class="inline-block rounded px-2 py-0.5 text-xs font-medium text-white badge-{{ d.status }}">{{ d.status }}</span>
        <span class="inline-block rounded px-2 py-0.5 text-xs font-medium text-white badge-{{ payst }}">{{ payst }}</span>
        {% if d.status=='issued' and d.due_date and d.due_date < 'now'|date('Y-m-d') and d.balance > 0 %}<span class="inline-block rounded bg-red-600 px-2 py-0.5 text-xs font-medium text-white">overdue</span>{% endif %}
      </div>
    </div>
    <div class="inv-side">
      <div class="inv-cap">Total</div>
      <div class="inv-total">{{ d.total|idr }}</div>
      <div><span class="inv-balance {{ d.balance == 0 ? 'ok' }}">{{ d.balance == 0 ? 'Settled' : 'Due ' ~ d.balance|idr }}</span></div>
    </div>
  </div>
  <div class="inv-meta">
    <div><div class="k">Customer</div><div class="v">{{ d.customer_snapshot ? (d.customer_snapshot|json_decode).name : '' }}</div></div>
    <div><div class="k">Date</div><div class="v">{{ d.doc_date|d }}</div></div>
    <div><div class="k">Due</div><div class="v">{{ d.due_date|d }}</div></div>
    <div><div class="k">Reference</div><div class="v">{{ d.reference ?? '-' }}{% if d.source_quotation_id %} · <a class="text-brand-600 hover:underline" href="/quotations/{{ d.source_quotation_id }}">QT #{{ d.source_quotation_id }}</a>{% endif %}</div></div>
    <div><div class="k">Signature</div><div class="v">{{ d.show_signature ? 'On PDF' : '—' }}</div></div>
  </div>
  <div class="inv-actions">
    {% if d.status=='draft' %}<a class="btn btn-default btn-sm" href="/invoices/{{ d.id }}/edit">Edit</a>
    <form style="display:inline" method="post" action="/invoices/{{ d.id }}/issue">{{ csrf() }}<button class="btn btn-primary btn-sm" onclick="return confirm('Issue invoice?')">Issue</button></form>{% endif %}
    {% if d.status=='issued' %}<form style="display:inline" method="post" action="/invoices/{{ d.id }}/cancel">{{ csrf() }}<input type="hidden" name="reason" value="cancelled from UI"><button class="btn btn-danger btn-sm" onclick="return confirm('Cancel invoice?')">Cancel</button></form>{% endif %}
    <a class="btn btn-default btn-sm" href="/invoices/{{ d.id }}/pdf" target="_blank">Preview PDF</a>
    <a class="btn btn-default btn-sm" href="/invoices/{{ d.id }}/pdf?dl=1">Download</a>
  </div>
</div>
{% for sec in d.sections %}<div class="card mb-3 p-4"><div class="inv-sec-head"><span class="inv-sec-no">{{ loop.index }}</span><h4 class="font-display text-lg">{{ sec.title }}</h4></div>
{% if sec.description %}<p class="mb-1 text-sm text-slate-500">{{ sec.description }}</p>{% endif %}
<div class="overflow-x-auto"><table class="tbl mt-2 w-full text-sm"><thead><tr><th class="px-2 py-1.5">Description</th><th class="px-2 py-1.5">Qty</th><th class="px-2 py-1.5">Multiplier</th><th class="px-2 py-1.5 text-right">Price</th><th class="px-2 py-1.5 text-right">Total</th></tr></thead><tbody>
{% for l in sec.lines %}<tr class="border-t border-slate-100"><td class="px-2 py-1.5">{{ l.description }}{% if l.waived %} <span class="inline-block rounded bg-slate-500 px-2 py-0.5 text-xs font-medium text-white">{{ l.price_mode }}</span>{% endif %}</td><td class="px-2 py-1.5 whitespace-nowrap">{{ l.quantity|qty(l.unit_label) }} {{ l.unit_label }}</td><td class="px-2 py-1.5 whitespace-nowrap">{% if l.waived %}—{% elseif l.mult_enabled %}{{ l.mult_value|qty }} {{ l.mult_label }}{% else %}–{% endif %}</td><td class="px-2 py-1.5 text-right whitespace-nowrap inv-num">{{ l.waived ? l.price_mode|capitalize : l.unit_price|idr }}</td><td class="px-2 py-1.5 text-right whitespace-nowrap inv-num">{{ l.line_amount|idr }}</td></tr>{% endfor %}
</tbody></table></div></div>{% endfor %}
<div class="card mb-3 p-4"><table class="inv-totals w-full text-sm"><tr><td class="py-1 text-slate-500">Subtotal</td><td class="py-1 text-right n">{{ d.subtotal|idr }}</td></tr><tr><td class="py-1 text-slate-500">Discount</td><td class="py-1 text-right n">− {{ d.discount_amount|idr }}</td></tr><tr><td class="py-1 text-slate-500">Tax</td><td class="py-1 text-right n">{{ d.tax_total|idr }}</td></tr><tr class="inv-grand"><td class="py-1">Total</td><td class="py-1 text-right n">{{ d.total|idr }}</td></tr>
<tr><td class="py-1 text-slate-500">Requested DP</td><td class="py-1 text-right n">{{ d.dp_amount|idr }}</td></tr><tr><td class="py-1 text-slate-500">DP received</td><td class="py-1 text-right n">{{ d.dp_paid|idr }}</td></tr><tr><td class="py-1 text-slate-500">Total paid</td><td class="py-1 text-right n">{{ d.paid|idr }}</td></tr><tr class="inv-due"><td class="py-1">Outstanding balance</td><td class="py-1 text-right n">{{ d.balance|idr }}</td></tr></table></div>
<div class="card mb-3 p-4"><h4 class="font-display mb-2 text-lg">Payment instructions</h4>{% for b in d.banks %}{% set s = b.snapshot|json_decode %}<p class="text-sm">{{ s.bank_name }} · {{ s.account_number }} · {{ s.holder }}{% if s.branch %} ({{ s.branch }}){% endif %}{% if s.note %}<br><span class="text-slate-500">{{ s.note }}</span>{% endif %}</p>{% else %}<p class="text-sm text-slate-400">No bank accounts attached — the PDF will show the company default account(s), if set.</p>{% endfor %}</div>
<div class="card mb-3 p-4"><h4 class="font-display mb-2 text-lg">Payments</h4>
<table class="tbl w-full text-sm"><thead><tr><th class="px-2 py-1.5">Date</th><th class="px-2 py-1.5 text-right">Amount</th><th class="px-2 py-1.5">Purpose</th><th class="px-2 py-1.5">Method</th><th class="px-2 py-1.5">Ref</th><th class="px-2 py-1.5"></th></tr></thead><tbody>
{% for p in d.payments %}<tr class="border-t border-slate-100"><td class="px-2 py-1.5">{{ p.pay_date|d }}</td><td class="px-2 py-1.5 text-right inv-num">{{ p.amount|idr }}</td><td class="px-2 py-1.5">{{ p.purpose }}</td><td class="px-2 py-1.5">{{ p.method }}</td><td class="px-2 py-1.5">{{ p.reference }}</td><td class="px-2 py-1.5">{% if not p.voided_at and d.status=='issued' %}<form method="post" action="/payments/{{ p.id }}/void">{{ csrf() }}<input type="hidden" name="reason" value="void from UI"><button class="btn btn-danger btn-sm" onclick="return confirm('Void payment?')">Void</button></form>{% else %}{{ p.voided_at ? 'voided' }}{% endif %}</td></tr>{% else %}<tr><td colspan="6" class="px-2 py-3 text-center text-slate-400">No payments.</td></tr>{% endfor %}
</tbody></table></div>
{% if d.status=='issued' and d.balance > 0 %}
<div class="card mb-3 p-4"><h4 class="font-display mb-2 text-lg">Record payment</h4>
<form method="post" action="/invoices/{{ d.id }}/payments" class="flex flex-wrap gap-2">{{ csrf() }}
<input class="field max-w-[10rem]" name="amount" placeholder="Amount IDR" required>
<input class="field max-w-[10rem]" type="date" name="pay_date" value="{{ 'now'|date('Y-m-d') }}">
<select class="field max-w-[10rem]" name="purpose"><option value="balance">balance</option><option value="dp">down payment</option><option value="other">other</option></select>
<input class="field max-w-[10rem]" name="method" value="Transfer">
<input class="field max-w-[10rem]" name="reference" placeholder="Reference">
<button class="btn btn-primary">Add payment</button></form></div>{% endif %}
<h4 class="font-display mb-1 text-lg">Audit</h4><ul class="list-disc pl-5 text-sm text-slate-600">{% for l in logs %}<li>{{ l.created_at }} — {{ l.action }} {{ l.detail }}</li>{% endfor %}</ul>
{% endblock %}
