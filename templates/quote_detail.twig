{% extends 'layout.twig' %}
{% block content %}
<h2 class="font-display mb-1 text-2xl">Quotation {{ d.number ? '#' ~ d.number : '(draft)' }} <span class="inline-block rounded px-2 py-0.5 text-xs font-medium text-white badge-{{ d.status }}">{{ d.status }}</span>
{% if d.status=='issued' and d.expiry_date and d.expiry_date < 'now'|date('Y-m-d') %}<span class="inline-block rounded bg-red-600 px-2 py-0.5 text-xs font-medium text-white">expired</span>{% endif %}</h2>
<p class="mb-4 text-sm text-slate-600">Customer: <a class="text-brand-600 hover:underline" href="/customers/{{ d.customer_id }}">{{ d.customer_name ?? (d.customer_snapshot|json_decode).name ?? '-' }}</a> · Date: {{ d.doc_date|d }} · Expiry: {{ d.expiry_date|d }}<br>Ref: {{ d.reference ?? '-' }}</p>
{% for sec in d.sections %}<div class="card mb-3 p-4"><h4 class="font-display text-lg">{{ sec.title }}</h4>{% if sec.description %}<p class="text-sm text-slate-500">{{ sec.description }}</p>{% endif %}
<div class="overflow-x-auto"><table class="tbl mt-2 w-full text-sm"><thead><tr><th class="px-2 py-1.5">Description</th><th class="px-2 py-1.5">Qty</th><th class="px-2 py-1.5">Multiplier</th><th class="px-2 py-1.5 text-right">Price</th><th class="px-2 py-1.5 text-right">Total</th></tr></thead><tbody>
{% for l in sec.lines %}<tr class="border-t border-slate-100"><td class="px-2 py-1.5">{{ l.description }}{% if l.waived %} <span class="inline-block rounded bg-slate-500 px-2 py-0.5 text-xs font-medium text-white">{{ l.price_mode }}</span>{% endif %}</td><td class="px-2 py-1.5 whitespace-nowrap">{{ l.quantity|qty(l.unit_label) }} {{ l.unit_label }}</td><td class="px-2 py-1.5 whitespace-nowrap">{% if l.waived %}—{% elseif l.mult_enabled %}{{ l.mult_value|qty }} {{ l.mult_label }}{% else %}–{% endif %}</td><td class="px-2 py-1.5 text-right whitespace-nowrap">{{ l.waived ? l.price_mode|capitalize : l.unit_price|idr }}</td><td class="px-2 py-1.5 text-right whitespace-nowrap">{{ l.line_amount|idr }}</td></tr>{% endfor %}
</tbody></table></div>{% endfor %}
<div class="card mb-3 p-4"><table class="w-full text-sm"><tr><td class="py-1">Subtotal</td><td class="py-1 text-right">{{ d.subtotal|idr }}</td></tr><tr><td class="py-1">Discount</td><td class="py-1 text-right">− {{ d.discount_amount|idr }}</td></tr><tr><td class="py-1">Tax</td><td class="py-1 text-right">{{ d.tax_total|idr }}</td></tr><tr class="font-semibold"><td class="py-1">Total</td><td class="py-1 text-right">{{ d.total|idr }}</td></tr><tr><td class="py-1">Requested DP{% if d.dp_due_date %} (due {{ d.dp_due_date|d }}){% endif %}</td><td class="py-1 text-right">{{ d.dp_amount|idr }}</td></tr><tr><td class="py-1">Remaining after DP</td><td class="py-1 text-right">{{ (d.total - d.dp_amount)|idr }}</td></tr></table></div>
<div class="card mb-3 p-4"><h4 class="font-display mb-1 text-lg">Payment instructions</h4>{% for b in d.banks %}{% set s = b.snapshot|json_decode %}<p class="text-sm">{{ s.bank_name }} · {{ s.account_number }} · {{ s.holder }}{% if s.branch %} ({{ s.branch }}){% endif %}{% if s.note %}<br><span class="text-slate-500">{{ s.note }}</span>{% endif %}</p>{% else %}<p class="text-sm text-slate-400">No bank accounts displayed.</p>{% endfor %}
<p class="mt-2 text-sm">Notes: {{ d.notes }}<br>Terms: {{ d.terms }}</p></div>
<div class="mb-4 flex flex-wrap gap-2">
{% if d.status=='draft' %}<a class="btn btn-default" href="/quotations/{{ d.id }}/edit">Edit</a>
<form style="display:inline" method="post" action="/quotations/{{ d.id }}/issue">{{ csrf() }}<button class="btn btn-primary" onclick="return confirm('Issue this quotation?')">Issue</button></form>
<form style="display:inline" method="post" action="/quotations/{{ d.id }}/delete">{{ csrf() }}<button class="btn btn-danger" onclick="return confirm('Delete draft?')">Delete</button></form>{% endif %}
{% if d.status=='issued' %}
<form style="display:inline" method="post" action="/quotations/{{ d.id }}/status">{{ csrf() }}<input type="hidden" name="to" value="accepted"><button class="btn btn-primary">Accept</button></form>
<form style="display:inline" method="post" action="/quotations/{{ d.id }}/status">{{ csrf() }}<input type="hidden" name="to" value="cancelled"><input type="hidden" name="reason" value="cancelled from UI"><button class="btn btn-danger" onclick="return confirm('Cancel?')">Cancel</button></form>{% endif %}
{% if d.status=='accepted' %}<form style="display:inline" method="post" action="/quotations/{{ d.id }}/convert">{{ csrf() }}<button class="btn btn-primary">{{ d.converted_invoice_id ? 'Open invoice' : 'Convert to invoice' }}</button></form>{% endif %}
{% if d.status in ['cancelled'] %}<form style="display:inline" method="post" action="/quotations/{{ d.id }}/delete">{{ csrf() }}<button class="btn btn-danger" onclick="return confirm('Delete this cancelled quotation? This cannot be undone.')">Delete</button></form>{% endif %}
<form style="display:inline" method="post" action="/quotations/{{ d.id }}/duplicate">{{ csrf() }}<button class="btn btn-default">Duplicate</button></form>
<a class="btn btn-default" href="/quotations/{{ d.id }}/pdf" target="_blank">Preview PDF</a>
<a class="btn btn-default" href="/quotations/{{ d.id }}/pdf?dl=1">Download</a>
</div>
<h4 class="font-display mb-1 text-lg">Audit</h4><ul class="list-disc pl-5 text-sm text-slate-600">{% for l in logs %}<li>{{ l.created_at }} — {{ l.action }} {{ l.detail }}</li>{% endfor %}</ul>
{% endblock %}
