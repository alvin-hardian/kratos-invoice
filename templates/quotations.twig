{% extends 'layout.twig' %}
{% block content %}
<div class="mb-4 flex items-center gap-3"><h2 class="font-display text-2xl">Quotations</h2><a class="btn btn-primary btn-sm" href="/quotations/new">New</a></div>
<form class="mb-3 flex flex-wrap gap-2" method="get"><input class="field max-w-xs" name="s" value="{{ q.s ?? '' }}" placeholder="Number / customer / ref"><select class="field max-w-[12rem]" name="status"><option value="">All statuses</option>{% for st in ['draft','issued','accepted','rejected','cancelled'] %}<option {{ q.status==st?'selected' }}>{{ st }}</option>{% endfor %}</select><button class="btn btn-default">Filter</button></form>
<div class="overflow-x-auto"><table id="qgrid" class="tbl w-full text-sm" data-url="/api/grid/quotations?s={{ (q.s ?? '')|url_encode }}&status={{ (q.status ?? '')|url_encode }}"></table></div>
<table class="tbl w-full text-sm" id="qgrid-fallback"><thead><tr><th class="px-3 py-2">Number</th><th class="px-3 py-2">Customer</th><th class="px-3 py-2">Date</th><th class="px-3 py-2 text-right">Total</th><th class="px-3 py-2">Status</th><th class="px-3 py-2"></th></tr></thead><tbody>
{% for r in rows %}<tr class="border-t border-slate-100"><td class="px-3 py-2"><a class="text-brand-600 hover:underline" href="/quotations/{{ r.id }}">{{ r.number ?? '(draft)' }}</a>{% if r.status=='issued' and r.expiry_date and r.expiry_date < 'now'|date('Y-m-d') %} <span class="inline-block rounded bg-red-600 px-2 py-0.5 text-xs font-medium text-white">expired</span>{% endif %}</td><td class="px-3 py-2">{{ r.customer_name }}</td><td class="px-3 py-2">{{ r.doc_date|d }}</td><td class="px-3 py-2 text-right">{{ r.total|idr }}</td><td class="px-3 py-2"><span class="inline-block rounded px-2 py-0.5 text-xs font-medium text-white badge-{{ r.status }}">{{ r.status }}</span></td><td class="px-3 py-2"><a class="btn btn-default btn-sm" href="/quotations/{{ r.id }}">Open</a></td></tr>{% else %}<tr><td colspan="6" class="px-3 py-4 text-center text-slate-400">No quotations.</td></tr>{% endfor %}
</tbody></table>
{% endblock %}
{% block scripts %}
<link rel="stylesheet" href="{{ asset('vendor/datatables/dataTables.dataTables.min.css') }}">
<link rel="stylesheet" href="{{ asset('css/datatables-uikit.css') }}">
<script src="{{ asset('vendor/datatables/dataTables.min.js') }}"></script>
<script src="{{ asset('js/grids.js') }}"></script>
<script>
mountDataTable('qgrid', [
  { data: 'number', title: 'Number', render: function(d, t, row) {
    if (t !== 'display' && t !== 'filter') return d;
    var extra = row.expired ? ' ' + badgeHtml('expired', 'badge-overdue') : '';
    return '<a class="text-brand-600 hover:underline" href="/quotations/' + row.id + '">' + escapeHtml(d) + '</a>' + extra;
  }},
  { data: 'customer', title: 'Customer' },
  { data: 'date_iso', title: 'Date', render: dateCell },
  { data: 'total_num', title: 'Total', className: 'dt-right', render: moneyCell },
  { data: 'status', title: 'Status', render: function(d, t) { return (t !== 'display' && t !== 'filter') ? d : statusHtml(d); } },
  { data: 'id', title: '', orderable: false, searchable: false, render: function(d) { return '<a class="btn btn-default btn-sm" href="/quotations/' + d + '">Open</a>'; } }
]);
</script>
{% endblock %}
