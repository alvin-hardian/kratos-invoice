APP_NAME="Kratos Invoice"
APP_ENV=dev
APP_DEBUG=1
APP_TIMEZONE=Asia/Jakarta
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=kratos_invoice
DB_USER=root
DB_PASS=root
# Name printed under the invoice signature placeholder (only used when the invoice has "show signature" enabled).
DIRECTOR_NAME=""
# MCP (Streamable HTTP, Bearer token). Generate with: php bin/mcp-token.php --write
MCP_ENABLED=1
MCP_TOKEN=change-me-to-a-long-random-token
MCP_ACTOR_ID=
MCP_READONLY=0
