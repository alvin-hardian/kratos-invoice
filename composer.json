{
    "name": "kratos/invoice",
    "description": "Quotation and invoice web application (Slim + Twig + MySQL + Dompdf)",
    "type": "project",
    "require": {
        "php": ">=8.3",
        "slim/slim": "^4.12",
        "slim/psr7": "^1.6",
        "slim/twig-view": "^3.3",
        "twig/twig": "^3.0",
        "dompdf/dompdf": "^2.0",
        "vlucas/phpdotenv": "^5.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": { "App\\": "src/" }
    },
    "config": { "optimize-autoloader": true }
}
